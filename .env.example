# ========================================================
# SURAKSHA LINK — MULTI-AGENT TOURIST SAFETY PLATFORM
# Environment Configuration Template
# ========================================================

# Application Port & Node Environment
PORT=3000
NODE_ENV=development

# Database Connection (MySQL / TiDB)
DATABASE_URL="mysql://user:password@localhost:3306/suraksha_db"

# Session & JWT Secrets
JWT_SECRET="suraksha_secure_jwt_secret_change_in_production"
VITE_APP_ID="suraksha-link"

# ========================================================
# MULTI-AGENT AI INTELLIGENCE KEYS (OPTIONAL)
# If left blank, the platform automatically runs in
# high-reliability deterministic simulation & rules mode!
# ========================================================

# OpenRouter LLM API (Powers Guardian AI contextual reasoning)
# Model options: anthropic/claude-3.5-haiku, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-haiku"

# Resend API Key (Powers emergency alert email dispatches)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="alerts@suraksha-safety.org"
EMERGENCY_DISPATCH_EMAIL="safety-control@suraksha.gov.in"

# Google Maps API Key (Powers dynamic safe corridor turn-by-turn routing)
# If unset, uses built-in GIS safe corridor engine with waypoint hazard weighting
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""
